ENVIRONMENT=development
HOST=127.0.0.1
PORT=3000

# Copia estos valores desde Aiven Console > tu servicio MySQL > Connection information.
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=replace_with_your_aiven_password
DB_NAME=casa_mundial

# Descarga el CA certificate desde Aiven y guárdalo como ca.pem en esta carpeta.
DB_SSL_CA=ca.pem

# Usa un valor aleatorio de al menos 32 caracteres. No lo compartas ni lo subas a Git.
JWT_SECRET=CHANGE_ME
